#!/usr/bin/env bash
set -euo pipefail

theme="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/tidal"
code="${XDG_DATA_HOME:-$HOME/.local/share}/wheely/themes/tidal"
# Omarchy's theme removal deletes only the folder, so this hook and what it runs leave too.
if [[ ! -d $theme && $0 == "$HOME"/.config/omarchy/hooks/* ]]; then rm -rf -- "$code" "$0"; exit 0; fi
if [[ "$(cat "$HOME/.local/state/omarchy/current/theme.name")" == tidal ]]; then
  # Never from the theme's folder: another theme installed under this name is not ours to run.
  exec "$code/tidal" watch
fi
