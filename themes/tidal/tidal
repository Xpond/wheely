#!/usr/bin/env bash
set -euo pipefail

theme=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
destination="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/tidal"

case "${1:-help}" in
  install)
    if [[ "$theme" != "$destination" ]]; then
      mkdir -p "$destination"
      cp -a "$theme/." "$destination/"
      # cp -a keeps the folder's old time, which hides a new preview from Omarchy's theme picker.
      touch "$destination"
    fi
    omarchy hook install theme-set "$destination/hooks/tidal-wallpaper"
    omarchy hook install post-boot "$destination/hooks/tidal-wallpaper"
    "$destination/tidal" watch
    printf 'Tidal installed. Apply it with: omarchy theme set tidal\n'
    ;;
  animate)
    case "${2:-colorful}" in
      colorful) wallpaper=00-living-coast-animated.png ;;
      muted) wallpaper=00-muted-coast-animated.png ;;
      *) printf 'Usage: %s animate [colorful|muted]\n' "$0" >&2; exit 1 ;;
    esac
    "$destination/tidal" watch
    exec omarchy theme bg set "$HOME/.local/state/omarchy/current/theme/backgrounds/$wallpaper"
    ;;
  watch)
    exec quickshell --no-duplicate --daemonize -p "$destination/animated"
    ;;
  stop|pause|resume|toggle)
    exec quickshell ipc -p "$destination/animated" call tidal "$1"
    ;;
  preview)
    exec quickshell --no-duplicate -p "$theme/preview.qml"
    ;;
  *)
    printf 'Usage: %s {install|animate|stop|pause|resume|toggle|preview}\n       %s animate [colorful|muted]\n' "$0" "$0"
    ;;
esac
