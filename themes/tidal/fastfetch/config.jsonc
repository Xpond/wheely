// Tidal: omarchy floats on the coast; the readout in marine ink over sea glass.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/fastfetch/logo.txt",
    "width": 58,
    "height": 21,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "disableLinewrap": true,
    "separator": "",
    "key": { "width": 13 },
    "color": { "keys": "#146A7C", "output": "#23444C" },
    "percent": { "color": { "green": "#397355", "yellow": "#89621D", "red": "#AF4B47" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[38;2;20;106;124m── shore  \u001b[38;2;127;189;180m────────────────────────────────────────" },
    { "type": "cpu", "key": "  cpu", "showPeCoreCount": true },
    { "type": "gpu", "key": "  gpu", "detectionMethod": "pci", "format": "{name}" },
    { "type": "memory", "key": "  memory" },
    { "type": "disk", "key": "󰋊  disk" },
    { "type": "display", "key": "󱄄  display" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;20;106;124m── current  \u001b[38;2;127;189;180m──────────────────────────────────────" },
    { "type": "command", "key": "  omarchy", "text": "echo \"$(omarchy-version) · $(omarchy-version-channel)\"" },
    { "type": "kernel", "key": "  kernel" },
    { "type": "wm", "key": "  wm" },
    { "type": "terminal", "key": "  terminal" },
    { "type": "packages", "key": "󰏖  packages" },
    { "type": "command", "key": "󰸌  theme", "text": "omarchy-theme-current" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;20;106;124m── tide  \u001b[38;2;127;189;180m─────────────────────────────────────────" },
    { "type": "command", "key": "󱦟  age", "text": "echo \"$(( ($(date +%s) - $(stat -c %W /var/log)) / 86400 )) days\"" },
    { "type": "uptime", "key": "󱫐  uptime" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 3 }
  ]
}
