#!/usr/bin/env bash
set -euo pipefail

theme="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/themes/wheelie"
# Omarchy's theme removal deletes only the folder, so the hook installed from it leaves too.
if [[ ! -d $theme && $0 == "$HOME"/.config/omarchy/hooks/* ]]; then rm -f -- "$0"; exit 0; fi
if [[ "$(cat "$HOME/.local/state/omarchy/current/theme.name")" == wheelie ]]; then
  exec "$theme/wheelie" watch
fi
